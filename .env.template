# Copy to .env and fill in values for local runs. Do not commit .env.
# For deployment these are set via `azd env set <key> <value>`.

# azd provisioning
AZURE_SUBSCRIPTION_ID="<subscription-id>"
AZURE_LOCATION="eastus"
AZURE_AI_PROJECT_NAME="<foundry-project-name>"

# Foundry project + model
FOUNDRY_PROJECT_ENDPOINT="https://<your-foundry>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-5.6-terra"

# GitHub PAT lookup (the agent reads the PAT from Key Vault at runtime)
AZURE_KEY_VAULT_URL="https://<your-key-vault>.vault.azure.net/"
GITHUB_PAT_SECRET_NAME="github-test-executor-pat"

# Target GitHub repository the agent commits generated tests to
GITHUB_OWNER="<github-owner>"
GITHUB_REPO="<github-repo>"

# Remote GitHub MCP server (override only if using GitHub Enterprise)
GITHUB_MCP_URL="https://api.githubcopilot.com/mcp/"

# GitHub MCP tools the agent may call (client-side allow-list within the server's default toolsets)
GITHUB_MCP_ALLOWED_TOOLS="create_branch,create_or_update_file,create_pull_request,get_file_contents,search_code,issue_read,search_issues"
